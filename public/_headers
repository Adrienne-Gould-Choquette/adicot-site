# Cloudflare Pages. Lives in public/ alongside _redirects, so the build copies it into _site.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# The project's own pages.dev address serves the same site. Keep it out of
# search results, so www.adicot.com is the only copy indexed.
https://adicot-site.pages.dev/*
  X-Robots-Tag: noindex
