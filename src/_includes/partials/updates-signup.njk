{#- Calculator Updates signup. Included in the footer on every page, and again
    at full width on /calculator-updates.

    The list host is not baked into the markup. `action` and the input names
    come from `site.updates` in src/_data/site.json, because every provider
    names its fields differently (email_address vs EMAIL vs email) and hardcoding
    one would mean editing templates to switch. Read the names off the provider's
    own embed code and put them in the data file.

    Set `nlWide` before including for the full-width variant.

    When `action` is empty the form is not rendered at all — unlike a broken
    action URL, a mailto line cannot silently swallow what someone types. -#}
{%- set nl = site.updates %}
{#- A placeholder address (YOUR-…) counts as not set: the form would only error. #}
{%- if nl.action and not ("YOUR-" in nl.action) %}
<form class="nlform{% if nlWide %} nlform-wide{% endif %}" method="POST" action="{{ nl.action }}">
  {%- if nl.redirectField %}
  <input type="hidden" name="{{ nl.redirectField }}" value="{{ site.url }}/calculator-updates/thanks">
  {%- endif %}
  {%- if nl.honeypotField %}
  {#- Honeypot, off-screen rather than display:none — some bots skip hidden fields. #}
  <p class="hp" aria-hidden="true">
    <label for="nl-hp{{ nlWide | default('') }}">Leave this field empty</label>
    <input id="nl-hp{{ nlWide | default('') }}" type="text" name="{{ nl.honeypotField }}" tabindex="-1" autocomplete="off">
  </p>
  {%- endif %}

  <div class="nlform-fields">
    {#- Required, and written to the Subscribers tab's first_name and last_name
        columns. Only rendered when the field names are set, since a guessed name
        would be accepted by the POST and then silently dropped. #}
    {%- if nl.firstNameField and nl.lastNameField %}
    <div class="field">
      <label for="nl-first{{ nlWide | default('') }}">First name <span class="req" aria-hidden="true">*</span></label>
      <input id="nl-first{{ nlWide | default('') }}" name="{{ nl.firstNameField }}" type="text" required autocomplete="given-name">
    </div>
    <div class="field">
      <label for="nl-last{{ nlWide | default('') }}">Last name <span class="req" aria-hidden="true">*</span></label>
      <input id="nl-last{{ nlWide | default('') }}" name="{{ nl.lastNameField }}" type="text" required autocomplete="family-name">
    </div>
    {%- endif %}
    <div class="field nlform-email">
      <label for="nl-email{{ nlWide | default('') }}">Email <span class="req" aria-hidden="true">*</span></label>
      <input id="nl-email{{ nlWide | default('') }}" name="{{ nl.emailField }}" type="email" required autocomplete="email">
    </div>
    <p class="form-actions">
      <button class="btn" type="submit">Sign up</button>
    </p>
  </div>
</form>
{%- else %}
<p class="nlform-fallback">
  Sign-up by form isn’t open yet. Email
  <a href="mailto:{{ site.contact.email }}?subject={{ nl.listName | urlencode }}">{{ site.contact.email }}</a>
  and we will add you to the list.
</p>
{%- endif %}
