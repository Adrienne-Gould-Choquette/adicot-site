{#- The break-even calculator, written by hand rather than published from
    SpreadsheetConverter. The maths is in /assets/js/breakeven.js, which
    check-calculators.mjs holds to the workbook's own answers; this is only the
    form. It never submits: nothing leaves the browser. -#}
<form class="calcform" id="becalc" novalidate>
  <noscript>
    <p class="cf-noscript">This calculator runs in your browser and needs JavaScript.
    The method is written out below.</p>
  </noscript>

  <div class="cf-inputs">
    <div class="field">
      <label for="be-name">Project <span class="opt">(optional, for the printout)</span></label>
      <input type="text" id="be-name" name="nm" autocomplete="off" placeholder="New product line">
    </div>
    {%- set groups = [
      ["Sales", [["pr", "Sales price per unit", "25", true], ["vo", "Sales volume per period, units", "2000", true]]],
      ["Variable costs per unit", [["c1", "Commission", "1.50"], ["c2", "Direct material", "6"], ["c3", "Shipping", "1.25"], ["c4", "Supplies", "0.50"], ["c5", "Other variable costs", "0.75"]]],
      ["Fixed costs per period", [["f1", "Administrative", "4000"], ["f2", "Insurance", "900"], ["f3", "Property tax", "450"], ["f4", "Rent", "6000"], ["f5", "Other fixed costs", "1200"]]]
    ] %}
    {%- for g in groups %}
    <fieldset class="cf-stream">
      <legend>{{ g[0] }}</legend>
      {%- for f in g[1] %}
      <div class="field">
        <label for="be-{{ f[0] }}">{{ f[1] }}{% if f[0] != "vo" %} <span class="cf-u">$</span>{% endif %}{% if f[3] %} <span class="req" aria-hidden="true">*</span>{% endif %}</label>
        <input type="number" id="be-{{ f[0] }}" name="{{ f[0] }}" inputmode="decimal" step="any" min="0"{% if f[3] %} required{% endif %} autocomplete="off" placeholder="{{ f[2] }}">
      </div>
      {%- endfor %}
    </fieldset>
    {%- endfor %}

    <p class="cf-actions">
      <button type="reset" class="btn btn-quiet">Reset</button>
      <button type="button" class="btn btn-quiet" id="be-share" hidden>Copy link to this result</button>
      <span class="cf-copied" id="be-copied" role="status"></span>
    </p>
  </div>

  <section class="cf-results" aria-labelledby="be-results-h">
    <h2 id="be-results-h">Results</h2>
    <p class="cf-summary" id="be-summary" role="status">Enter the sales price per unit.</p>
    <table class="cf-table" id="be-table" hidden>
      <caption class="visually-hidden">Break-even point and profit</caption>
      <tbody id="be-tbody"></tbody>
    </table>
    <div class="table-scroll" id="be-vol-wrap" hidden>
      <table class="ref-table">
        <caption class="visually-hidden">Costs and profit from 0 to 100 % of the sales volume</caption>
        <thead><tr><th scope="col">Volume</th><th scope="col">Units</th><th scope="col">Total costs</th><th scope="col">Sales</th><th scope="col">Profit</th></tr></thead>
        <tbody id="be-vtbody"></tbody>
      </table>
    </div>
  </section>
</form>
