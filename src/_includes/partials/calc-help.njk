{#- Help chat on a hand-written calculator page: a bubble fixed to the bottom
    right that opens a chat window. calc-help.js posts each question, with the
    visitor's current inputs and results, to /api/calc-help, where the Flask app
    reads this page from the live site and asks Claude Haiku. Hidden until the
    script runs, since without it the chat could do nothing. -#}
<div class="chelp" id="chelp" hidden>
  <section class="chelp-panel" id="chelp-panel" role="dialog" aria-labelledby="chelp-h" hidden>
    <header class="chelp-head">
      <h2 id="chelp-h">Calculator help</h2>
      <button type="button" class="chelp-close" id="chelp-close" aria-label="Close help">&times;</button>
    </header>
    <div class="chelp-log" id="chelp-log" aria-live="polite">
      <p class="chelp-msg chelp-bot">Hi! Ask me anything about using this calculator: what an input means, where to find a value, or why you got a result.</p>
    </div>
    <form class="chelp-form" id="chelp-form">
      <label for="chelp-q" class="visually-hidden">Your question</label>
      <textarea id="chelp-q" rows="2" maxlength="1000" placeholder="Type your question" required></textarea>
      <button class="btn" type="submit">Ask</button>
    </form>
    <p class="chelp-note">An AI assistant (Claude) that reads this page. It can make mistakes: check important numbers, and confirm design decisions with a licensed engineer.</p>
  </section>
  <button type="button" class="chelp-bubble" id="chelp-open" aria-expanded="false" aria-controls="chelp-panel" aria-label="Questions about this calculator? Open the help chat" title="Questions? Ask the help assistant">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-5A8 8 0 1 1 21 12z"/><path d="M9.5 9.5a2.5 2.5 0 1 1 3.3 2.4c-.5.2-.8.6-.8 1.1v.5"/><path d="M12 16.5h.01"/></svg>
  </button>
</div>
<script src="{{ '/assets/js/calc-help.js' | bust }}" defer></script>
