{#- The temperature converter, written by hand rather than published from
    SpreadsheetConverter. The maths is in /assets/js/tempconv.js, which
    check-calculators.mjs holds to the workbook's own answers; this is only the
    form. It never submits: nothing leaves the browser. -#}
<form class="calcform" id="tempcalc" novalidate>
  <noscript>
    <p class="cf-noscript">This converter runs in your browser and needs JavaScript.
    Every formula it uses is written out below, with a table of common temperatures.</p>
  </noscript>

  <div class="cf-inputs">
    <div class="field">
      <label for="tc-temp">Temperature <span class="req" aria-hidden="true">*</span></label>
      <input type="number" id="tc-temp" name="t" inputmode="decimal" step="any"
             required autocomplete="off" placeholder="70">
    </div>

    <fieldset class="cf-radios cf-stack">
      <legend>Entered in</legend>
      {%- for s in [["F", "Fahrenheit", "°F"], ["C", "Celsius", "°C"], ["K", "Kelvin", "K"], ["R", "Rankine", "°R"]] %}
      <label><input type="radio" name="u" value="{{ s[0] }}"{% if loop.first %} checked{% endif %}> {{ s[1] }} ({{ s[2] }})</label>
      {%- endfor %}
    </fieldset>

    <p class="cf-actions">
      <button type="reset" class="btn btn-quiet">Reset</button>
      <button type="button" class="btn btn-quiet" id="tc-share" hidden>Copy link to this result</button>
      <span class="cf-copied" id="tc-copied" role="status"></span>
    </p>
  </div>

  {#- The one-line summary is the live region; the table is not, so a screen
      reader hears one sentence per change rather than four rows. -#}
  <section class="cf-results" aria-labelledby="tc-results-h">
    <h2 id="tc-results-h">Results</h2>
    <p class="cf-summary" id="tc-summary" role="status">Enter a temperature.</p>
    <table class="cf-table" id="tc-table" hidden>
      <caption class="visually-hidden">The temperature entered, in all four scales</caption>
      <tbody id="tc-tbody"></tbody>
    </table>
    <p class="cf-note" id="tc-note">Exact conversions: a Celsius degree is 9/5 of a Fahrenheit degree,
    0 °C is 273.15 K, and 0 °F is 459.67 °R.</p>
  </section>
</form>
