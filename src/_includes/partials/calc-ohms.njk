{#- Ohm's law with power, written by hand rather than published from
    SpreadsheetConverter. The maths is in /assets/js/ohms.js, which
    check-calculators.mjs holds to the workbook's own answers; this is only the
    form. It never submits: nothing leaves the browser. -#}
<form class="calcform" id="ohmcalc" novalidate>
  <noscript>
    <p class="cf-noscript">This calculator runs in your browser and needs JavaScript.
    Every equation it uses is written out below.</p>
  </noscript>

  <div class="cf-inputs">
    <p class="hint">Enter any two values.</p>
    {%- for f in [["V", "Voltage", "V", "volts", "208"], ["I", "Current", "I", "amps", "21.63"], ["R", "Resistance", "R", "ohms", "9.61"], ["P", "Power", "P", "watts", "4500"]] %}
    <div class="field">
      <label for="ohm-{{ f[0] }}">{{ f[1] }}, {{ f[2] }} <span class="cf-u">{{ f[3] }}</span></label>
      <input type="number" id="ohm-{{ f[0] }}" name="{{ f[0] | lower }}" inputmode="decimal" step="any" min="0"
             autocomplete="off" placeholder="{{ f[4] }}">
    </div>
    {%- endfor %}

    <p class="cf-actions">
      <button type="reset" class="btn btn-quiet">Reset</button>
      <button type="button" class="btn btn-quiet" id="ohm-share" hidden>Copy link to this result</button>
      <span class="cf-copied" id="ohm-copied" role="status"></span>
    </p>
  </div>

  <section class="cf-results" aria-labelledby="ohm-results-h">
    <h2 id="ohm-results-h">Results</h2>
    <p class="cf-summary" id="ohm-summary" role="status">Enter any two values.</p>
    <table class="cf-table" id="ohm-table" hidden>
      <caption class="visually-hidden">Voltage, current, resistance and power</caption>
      <tbody id="ohm-tbody"></tbody>
    </table>
    <p class="cf-note">V = I × R; P = V × I = I² × R = V² ÷ R.</p>
  </section>
</form>
