{#- The home price comparison, written by hand rather than published from
    SpreadsheetConverter. The maths is in /assets/js/homeprice.js, which
    check-calculators.mjs holds to the workbook's own answers; this is only the
    form. It never submits: nothing leaves the browser. -#}
<form class="calcform" id="hpcalc" novalidate>
  <noscript>
    <p class="cf-noscript">This calculator runs in your browser and needs JavaScript.
    The method is written out below.</p>
  </noscript>

  <div class="cf-inputs">
    {%- set groups = [
      ["Savings", [["sv", "Total savings", "$", "100000", true], ["ir", "Interest rate on savings", "% a year", "3.63", false], ["tr", "Income tax rate on interest", "%", "24", false]]],
      ["Current housing (monthly)", [["rn", "Rent or mortgage", "$", "2400", false], ["ho", "HOA", "$", "0", false], ["in", "Insurance", "$", "25", false], ["pk", "Parking", "$", "150", false]]],
      ["New home", [["pp", "Purchase price", "$", "450000", true], ["cc", "Closing costs", "% of price", "1", false], ["mr", "Annual mortgage rate", "%", "7.03", false], ["yr", "Number of years", "", "30", false], ["nh", "HOA (monthly)", "$", "350", false], ["np", "Parking (monthly)", "$", "0", false], ["hi", "Home insurance", "% of price a year", "0.49", false], ["pt", "Property tax", "% of price a year", "0.90", false]]]
    ] %}
    {%- for g in groups %}
    <fieldset class="cf-stream">
      <legend>{{ g[0] }}</legend>
      {%- for f in g[1] %}
      <div class="field">
        <label for="hp-{{ f[0] }}">{{ f[1] }}{% if f[2] %} <span class="cf-u">{{ f[2] }}</span>{% endif %}{% if f[4] %} <span class="req" aria-hidden="true">*</span>{% endif %}</label>
        <input type="number" id="hp-{{ f[0] }}" name="{{ f[0] }}" inputmode="decimal" step="any" min="0"{% if f[4] %} required{% endif %} autocomplete="off" placeholder="{{ f[3] }}"{% if f[0] == "tr" %} value="24"{% elif f[0] == "cc" %} value="1"{% elif f[0] == "hi" %} value="0.49"{% elif f[0] == "pt" %} value="0.90"{% endif %}>
      </div>
      {%- endfor %}
    </fieldset>
    {%- endfor %}

    <p class="cf-actions">
      <button type="reset" class="btn btn-quiet">Reset</button>
      <button type="button" class="btn btn-quiet" id="hp-share" hidden>Copy link to this result</button>
      <span class="cf-copied" id="hp-copied" role="status"></span>
    </p>
  </div>

  <section class="cf-results" aria-labelledby="hp-results-h">
    <h2 id="hp-results-h">Comparison</h2>
    <p class="cf-summary" id="hp-summary" role="status">Enter the purchase price.</p>
    <table class="cf-table" id="hp-table" hidden>
      <caption class="visually-hidden">Current and new monthly housing costs and interest income</caption>
      <tbody id="hp-tbody"></tbody>
    </table>
    <p class="cf-note">An estimate. Enter your area's home insurance and property tax rates; left blank,
    they are taken as 0.49 % and 0.90 % of the purchase price a year, the US averages: insurance from
    Freddie Mac (2023, $4.90 per $1,000 of home value) and property tax from the Census Bureau's 2024
    American Community Survey. Both vary widely by state: Florida is about 0.76 % and 0.75 %,
    Massachusetts about 0.35 % and 1.00 %. The example mortgage rate, 7.03 %, is
    Freddie Mac's 30-year fixed average for the week of 24 September 2026; enter the rate you are quoted.
    The example savings rate, 3.63 %, is the benchmark (federal funds) rate the FDIC lists for savings
    deposits in September 2026, which high-yield accounts track; the national average savings rate is 0.37 %.
    Enter what your savings actually earn.</p>
  </section>
</form>
