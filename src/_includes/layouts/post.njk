---
layout: layouts/base.njk
---
<article class="page post">
  <header class="page-head">
    <p class="crumb"><a href="/blog">Blog</a></p>
    <h1>{{ title }}</h1>
    <p class="meta">
      {{ site.author }} &middot; <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {%- if categories.length %} &middot;
      {%- for c in categories %}
      <a href="/blog/categories/{{ c }}">{{ blogCategoryNames[c] or c }}</a>{% if not loop.last %}, {% endif %}
      {%- endfor %}{% endif %}
    </p>
  </header>

  <div class="prose">
    {{ content | safe }}
  </div>

  {%- set postUrl = page.url | cleanUrl %}
  {%- set calc = crossLinks.postCalculator[postUrl] %}
  {%- set svcs = crossLinks.postServices[postUrl] %}
  {%- if calc or svcs %}
  <div class="crosslinks">
    {%- if calc %}
    <p>Calculator for this post: <a href="{{ calc.path }}">{{ calc.label }}</a></p>
    {%- endif %}
    {%- for s in svcs or [] %}
    <p>Engineering service: <a href="{{ s.url }}">{{ s.name }}</a></p>
    {%- endfor %}
  </div>
  {%- endif %}

  <nav class="post-nav" aria-label="More posts">
    <a href="/blog">&larr; All posts</a>
  </nav>
</article>
