---
layout: layouts/base.njk
title: Engineering Services
seoTitle: "HVAC Load Calculations & Energy Code Compliance | adicot.com"
description: "Engineer-stamped HVAC load calculations and energy code compliance for industrial, commercial and multi-family projects. Licensed in 11 states."
permalink: /services.html
pageScript: services.js
---
<section class="svc-hero">
  <p class="eyebrow">{{ services.eyebrow }}</p>
  {#- Each entry is its own line. The break is deliberate, so it is marked up
      rather than left to wherever the browser happens to wrap. #}
  <h1 class="svc-headline">
    {%- for line in services.headline %}<span>{{ line }}</span>{% endfor %}
  </h1>
  <p class="lede">{{ services.lede }}</p>
  <p class="segments">
    {%- for s in services.segments %}<span>{{ s }}</span>{% endfor %}
  </p>
  <p class="cta-row">
    <a class="btn" href="{{ site.quoteUrl }}">{{ site.quoteLabel }} &rarr;</a>
    <a class="btn btn-quiet" href="#services">See what we do</a>
  </p>
</section>

{#- The two cards double as the way into the two primary service pages. The
    images carry their own wording, so the alt text repeats it rather than
    describing the photograph: someone who cannot see the card still gets what
    it says. Generated by build-service-images.mjs. -#}
<nav class="svc-promos" aria-label="Primary services">
  <a href="/services/cooling-load-calculations">
    <picture>
      <source srcset="/assets/og-load-calculations.webp" type="image/webp">
      <img src="/assets/og-load-calculations.png" width="1200" height="630" loading="lazy"
           alt="HVAC Load Calculations. Engineer stamped. Room-by-room loads,
                worked to the governing code, assumptions written down.">
    </picture>
  </a>
  <a href="/services/energy-code-compliance">
    <picture>
      <source srcset="/assets/og-energy-code-compliance.webp" type="image/webp">
      <img src="/assets/og-energy-code-compliance.png" width="1200" height="630" loading="lazy"
           alt="Energy Code Compliance. Engineer stamped. Performance path modeling,
                the code your state adopted, plan-review ready.">
    </picture>
  </a>
</nav>

<section class="stats" aria-label="Practice at a glance">
  {%- for s in services.stats %}
  <div>
    <b>{{ s.figure }}</b>
    <span>{{ s.label }}</span>
    {% if s.note %}<small>{{ s.note }}</small>{% endif %}
  </div>
  {%- endfor %}
</section>

<section class="svc-list" id="services">
  <h2>What we do</h2>
  <p class="sub">We do HVAC load calculations and energy code compliance for architects,
  builders, developers and engineers. Send us your plans; we send back stamped calculations,
  ready for plan review.</p>

  <p class="sub">Licensure in eleven states, with NCEES Model Law standing behind an
  application anywhere else, means work spread across jurisdictions does not mean
  briefing a new engineer at every border.</p>

  <ol class="svc-cards">
    {%- for item in services.items %}
    <li class="svc-card{% if item.page %} is-primary{% else %} is-gated{% endif %}">
      {#- The firm's own hand-drawn mark, the same set the calculator cards use.
          Decorative: the heading below already names the service. -#}
      <p class="svc-top">
        <img class="svc-icon" src="{{ item.icon | iconUrl }}" width="34" height="34" loading="lazy" alt="">
        <span class="svc-n">{{ item.n }}</span>
      </p>
      <h3>
        {%- if item.page %}<a href="/services/{{ item.slug }}">{{ item.name }}</a>
        {%- else %}<a class="svc-gate" href="/contact" data-service="{{ item.name }}">{{ item.name }}</a>{% endif %}
      </h3>
      {% if item.stamped %}<span class="stamp">Engineer stamped</span>{% endif %}
      {% if not item.page %}<span class="stamp stamp-quiet">Existing clients</span>{% endif %}
      <p>{{ item.summary }}</p>
      <p class="svc-links">
        {%- if item.page %}
        <a href="/services/{{ item.slug }}">Read more &rarr;</a> &middot;
        <a href="{{ site.quoteUrl }}">{{ site.quoteLabel }} &rarr;</a>
        {%- else %}
        <a class="svc-gate" href="/contact" data-service="{{ item.name }}">Inquire &rarr;</a>
        {%- endif %}
      </p>
    </li>
    {%- endfor %}
  </ol>
</section>

<dialog id="svc-gate" class="gate" aria-labelledby="gate-title">
  <h2 id="gate-title">Available to existing clients</h2>
  <p id="gate-body">This service is offered to existing clients. Please contact us for more information.</p>
  <p class="gate-actions">
    <a class="btn" href="/contact">Contact us &rarr;</a>
    <button type="button" class="btn btn-quiet" data-gate-close>Close</button>
  </p>
</dialog>

<section class="pricing">
  {#- Same mark treatment as the service cards above. -#}
  <p class="svc-top">
    <img class="svc-icon" src="{{ services.pricingIcon | iconUrl }}" width="34" height="34" loading="lazy" alt="">
  </p>
  <h2>Most services priced instantly</h2>
  <p>No phone tag. No multi-day waits to hear what something costs. Tell us your project type, square footage and turnaround. We'll show the fee on screen, then review your inquiry and confirm scope shortly after. Most load calculations are priced instantly and returned within 5-10 business days of scope confirmation.</p>
  <p><a class="btn" href="{{ site.quoteUrl }}">{{ site.quoteLabel }} &rarr;</a></p>
</section>
